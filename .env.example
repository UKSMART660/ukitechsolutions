# Copy to .env and fill in real production values. Never commit .env.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ukitechsolutions?sslmode=require
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Admin password is set interactively using npm run create-admin
# Optional email notifications. Contact messages are stored in PostgreSQL even if SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=iliyasuukacha660@gmail.com
FROM_EMAIL=
TRUST_PROXY=1
